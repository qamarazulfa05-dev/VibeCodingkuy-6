APP_NAME="Perpustakaan API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perpustakaan_uts
DB_USERNAME=root
DB_PASSWORD=

# Tidak memakai tabel session/cache/queue untuk API ini.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
